{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":timezone(Asia/Tokyo)",
    "schedule:weekly"
  ],
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "ワークフローの、renovateのコメントを付けたツールの版",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[^\\n]*?(?:version: |--version )(?<currentValue>\\d[\\w.-]*)"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "rust-toolchain.tomlのRustの版を、1つのPull Requestで更新する。Cargo.tomlのrust-versionは、最小のRustの版であるため、手動で更新する",
      "matchDepNames": ["rust", "docker.io/library/rust"],
      "groupName": "Rust toolchain"
    },
    {
      "description": "GitHub Actionsは、まとめて1つのPull Requestで更新する",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "GitHub Actions"
    }
  ]
}
